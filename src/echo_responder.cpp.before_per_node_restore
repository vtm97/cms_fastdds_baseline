using namespace eprosima::fastdds::dds;

struct Options
{
    uint32_t domain_id = 1;
    std::string request_topic = "CmsRttRequest";
    std::string echo_topic = "CmsRttEcho";
    uint32_t count = 100;
    std::string qos_file = "./config/qos_baseline.xml";
};

static void usage(const char* prog)
{
    std::cout
        << "Usage:\n  " << prog
        << " [--domain-id N]"
        << " [--request-topic NAME]"
        << " [--echo-topic NAME]"
        << " [--count N]"
        << " [--qos FILE]\n";
}

static bool parse_args(int argc, char** argv, Options& o)
{
    for (int i = 1; i < argc; ++i)
    {
        std::string a = argv[i];

        if (a == "--domain-id" && i + 1 < argc)
        {
            o.domain_id = std::stoul(argv[++i]);
        }
        else if (a == "--request-topic" && i + 1 < argc)
        {
            o.request_topic = argv[++i];
        }
        else if (a == "--echo-topic" && i + 1 < argc)
        {
            o.echo_topic = argv[++i];
        }
        else if (a == "--count" && i + 1 < argc)
        {
            o.count = std::stoul(argv[++i]);
        }
        else if (a == "--qos" && i + 1 < argc)
        {
            o.qos_file = argv[++i];
        }
        else if (a == "--help")
        {
            usage(argv[0]);
            return false;
        }
       else
        {
            std::cerr << "Unknown/incomplete argument: " << a << '\n';
            usage(argv[0]);
            return false;
        }
    }

    return true;
}

class EchoResponder
{
public:

    explicit EchoResponder(const Options& options)
        : options_(options)
        , type_(new cms::CmsMessagePubSubType())
    {
    }

    ~EchoResponder()
    {
        if (participant_ != nullptr)
        {
            participant_->delete_contained_entities();
            DomainParticipantFactory::get_instance()
                ->delete_participant(participant_);
        }
    }

    bool init()
    {
        if (DomainParticipantFactory::get_instance()
                ->load_XML_profiles_file(options_.qos_file) != RETCODE_OK)
        {
            std::cerr
                << "Failed to load QoS XML: "
                << options_.qos_file << '\n';
            return false;
        }

        std::cout
            << "Loaded QoS XML: "
            << options_.qos_file << '\n';

        participant_ =
            DomainParticipantFactory::get_instance()
                ->create_participant(
                    options_.domain_id,
                    PARTICIPANT_QOS_DEFAULT);

        if (participant_ == nullptr)
        {
            std::cerr << "Failed to create participant.\n";
            return false;
        }

        if (type_.register_type(participant_) != RETCODE_OK)
        {
            std::cerr << "Failed to register CmsMessage.\n";
            return false;
        }

        request_topic_ =
            participant_->create_topic(
                options_.request_topic,
                type_.get_type_name(),
                TOPIC_QOS_DEFAULT);

        echo_topic_ =
            participant_->create_topic(
                options_.echo_topic,
                type_.get_type_name(),
                TOPIC_QOS_DEFAULT);

        if (request_topic_ == nullptr || echo_topic_ == nullptr)
        {
            std::cerr << "Failed to create topics.\n";
            return false;
        }

        publisher_ =
            participant_->create_publisher(
                PUBLISHER_QOS_DEFAULT);

        subscriber_ =
            participant_->create_subscriber(
                SUBSCRIBER_QOS_DEFAULT);

        if (publisher_ == nullptr || subscriber_ == nullptr)
        {
            std::cerr << "Failed to create publisher/subscriber.\n";
            return false;
        }

        writer_ =
            publisher_->create_datawriter_with_profile(
                echo_topic_,
                "cms_writer_profile",
                &writer_listener_);

        if (writer_ == nullptr)
        {
            std::cerr << "Failed to create echo DataWriter.\n";
            return false;
        }

        reader_listener_.owner = this;

        reader_ =
            subscriber_->create_datareader_with_profile(
                request_topic_,
                "cms_reader_profile",
                &reader_listener_);

        if (reader_ == nullptr)
        {
            std::cerr << "Failed to create request DataReader.\n";
            return false;
        }

        std::cout
            << "DDS RTT echo responder initialized.\n"
            << "Domain        : " << options_.domain_id << '\n'
            << "Request topic : " << options_.request_topic << '\n'
            << "Echo topic    : " << options_.echo_topic << '\n'
            << "Expected      : " << options_.count << '\n';

        return true;
    }

    void run()
    {
        std::cout << "Waiting for RTT requests...\n";

        uint32_t last_processed = processed_.load();

        auto last_progress =
            std::chrono::steady_clock::now();

        while (processed_.load() < options_.count)
        {
            std::this_thread::sleep_for(
                std::chrono::milliseconds(100));

            const uint32_t current =
                processed_.load();

            if (current != last_processed)
            {
                last_processed = current;
                last_progress =
                    std::chrono::steady_clock::now();
            }

            const auto idle =
                std::chrono::duration_cast<std::chrono::seconds>(
                    std::chrono::steady_clock::now()
                    - last_progress);

            if (idle.count() >= 10)
            {
                std::cerr
                    << "Responder idle timeout: no new requests "
                    << "for 10 seconds.\n";
                break;
            }
        }

        std::cout
            << "\nEcho responder completed.\n"
            << "received = " << received_.load() << '\n'
            << "processed = " << processed_.load() << '\n'
            << "echoed   = " << echoed_.load() << '\n';

        writer_->wait_for_acknowledgments(
            Duration_t(2, 0));
    }

private:

    class WriterListener : public DataWriterListener
    {
    public:

        void on_publication_matched(
                DataWriter*,
                const PublicationMatchedStatus& status) override
        {
            std::cout
                << "[DDS] Echo writer matched. current readers = "
                << status.current_count << '\n';
        }
    };

    class ReaderListener : public DataReaderListener
    {
    public:

        EchoResponder* owner = nullptr;

        void on_subscription_matched(
                DataReader*,
                const SubscriptionMatchedStatus& status) override
        {
            std::cout
                << "[DDS] Request reader matched. current writers = "
                << status.current_count << '\n';
        }

        void on_sample_rejected(
                DataReader*,
                const SampleRejectedStatus& info) override
        {
            std::cerr
                << "[DDS] SAMPLE REJECTED"
                << " change=" << info.total_count_change
                << " total=" << info.total_count
                << " reason="
                << static_cast<int>(info.last_reason)
                << '\n';
        }

        void on_sample_lost(
                DataReader*,
                const SampleLostStatus& info) override
        {
            std::cerr
                << "[DDS] SAMPLE LOST"
                << " change=" << info.total_count_change
                << " total=" << info.total_count
                << '\n';
        }

        void on_data_available(DataReader* reader) override
        {
            if (owner == nullptr)
            {
                return;
            }

            cms::CmsMessage message;
            SampleInfo info;

            while (reader->take_next_sample(&message, &info) == RETCODE_OK)
            {
                if (!info.valid_data)
                {
                    continue;
                }

                owner->received_.fetch_add(1);

                if (owner->writer_->write(&message) == RETCODE_OK)
                {
                    owner->echoed_.fetch_add(1);

                if (message.sequence_number() % 100 == 0 ||
                        message.sequence_number() + 1 == owner->options_.count)
                {

                    std::cout
                        << "ECHO"
                        << " node=" << message.node_id()
                        << " flow=" << message.flow_id()
                        << " seq=" << message.sequence_number()
                        << " payload=" << message.payload().size()
                        << " B\n";
                }
                }
                else
                {
                    std::cerr
                        << "Failed to echo seq="
                        << message.sequence_number()
                        << '\n';
                }
                
                owner->processed_.fetch_add(1);
            }
        }
    };

    Options options_;

    TypeSupport type_;

    DomainParticipant* participant_ = nullptr;

    Topic* request_topic_ = nullptr;
    Topic* echo_topic_ = nullptr;

    Publisher* publisher_ = nullptr;
    Subscriber* subscriber_ = nullptr;

    DataWriter* writer_ = nullptr;
    DataReader* reader_ = nullptr;

    WriterListener writer_listener_;
    ReaderListener reader_listener_;

    std::atomic<uint32_t> received_{0};
    std::atomic<uint32_t> echoed_{0};
    std::atomic<uint32_t> processed_{0};
};

int main(int argc, char** argv)
{
    Options options;

    if (!parse_args(argc, argv, options))
    {
        return 1;
    }

    EchoResponder responder(options);

    if (!responder.init())
    {
        return 1;
    }

    responder.run();

    return 0;
}
