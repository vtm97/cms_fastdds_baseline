<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

    <transport_descriptors>

        <transport_descriptor>
            <transport_id>udp_source</transport_id>
            <type>UDPv4</type>
            <interfaces>
                <allowlist>
                    <interface name="rsrc-ns" netmask_filter="OFF"/>
                </allowlist>
            </interfaces>
        </transport_descriptor>

        <transport_descriptor>
            <transport_id>udp_cms</transport_id>
            <type>UDPv4</type>
            <interfaces>
                <allowlist>
                    <interface name="rcms-ns" netmask_filter="OFF"/>
                </allowlist>
            </interfaces>
        </transport_descriptor>

    </transport_descriptors>

    <participant profile_name="router_source_profile">
        <domainId>0</domainId>
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>udp_source</transport_id>
            </userTransports>
        </rtps>
    </participant>

    <participant profile_name="router_cms_profile">
        <domainId>1</domainId>
        <rtps>
            <useBuiltinTransports>false</useBuiltinTransports>
            <userTransports>
                <transport_id>udp_cms</transport_id>
            </userTransports>
        </rtps>
    </participant>

</profiles>
